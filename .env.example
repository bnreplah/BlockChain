# DARM-ANN — environment configuration (copy to .env or set in your orchestrator).
# All variables are optional; safe defaults apply when unset. Grouped by concern.

# ── Server identity / listen ────────────────────────────────────────────────
PORT=3001                              # HTTP listen port (also 1st CLI arg to app.js)
NODE_URL=http://localhost:3001         # this node's self URL (also 2nd CLI arg)
ACS_NAME=                              # human label for this Autonomous Cognitive System

# ── Persistence (LTM snapshot + audit) ──────────────────────────────────────
DARM_SNAPSHOT=/data/node.json          # snapshot file; restored on boot, saved on shutdown
DARM_SNAPSHOT_MS=60000                 # periodic snapshot interval (ms); 0 disables
DARM_AUDIT_FILE=/data/audit.log        # operator-action audit trail (optional)

# ── Consensus / consolidation tuning ────────────────────────────────────────
DARM_MIN_AGE_MS=60000                  # min STM age before CDCP nomination (0 = instant, tests only)
DARM_TAU_C=0.67                        # BFT quorum threshold (2/3)
DARM_AUTOREMEDIATE=1                   # auto self-correct on chain-invalid alerts (0 disables)

# ── Security: RBAC tokens (enable auth by setting either) ───────────────────
# DARM_TOKENS wins; format "token:scope,token:scope" with scope read|operator.
DARM_TOKENS=                           # e.g. ops-secret:operator,ro-secret:read
DARM_AUTH_TOKEN=                       # legacy single operator-scope token
DARM_CLUSTER_TOKEN=                    # operator-scope token for inter-node gossip

# ── Security: rate limiting + TLS ───────────────────────────────────────────
DARM_RATE_CAPACITY=120                 # token-bucket capacity (per token/IP)
DARM_RATE_PER_SEC=60                   # bucket refill rate
DARM_TLS_CERT=                         # PEM cert path → serve API over HTTPS
DARM_TLS_KEY=                          # PEM key path

# ── Consensus mTLS (multi-process cluster) ──────────────────────────────────
DARM_CLUSTER_MTLS=0                    # 1 = mint CA + per-node certs for the TCP transport

# ── v7.2 Fabric (Distributed AI Lens) — this node as an ACS ─────────────────
ACS_STAKE=500                          # CCIL stake (elevates LEAF→ANCHOR with uptime/bvas)
ACS_LATENCY=5                          # advertised latency_class
ACS_PRICE=1                            # advertised price_curve base

# ── Agent runner (deploy/agent/runner.js) ───────────────────────────────────
AGENT_NAME=                            # agent label
AGENT_TIER=worker                      # knowledgeable | generalist | narrow | worker
AGENT_CAPS=                            # comma capabilities; empty = tier defaults
DARM_MODEL_URL=http://localhost:3001   # model/registry the agent registers to
DARM_TOKEN=                            # operator token the agent presents
AGENT_HEARTBEAT_MS=20000               # heartbeat interval
AGENT_HEARTBEAT_TIMEOUT_MS=60000       # server-side: mark agent offline after this

# ── VPN (agent come-online) ─────────────────────────────────────────────────
VPN_BACKEND=local                      # tailscale | generic | local
TS_AUTHKEY=                            # Tailscale auth key (VPN_BACKEND=tailscale)
TS_LOGIN_SERVER=                       # Tailscale/Headscale control URL (empty = default coordinator)
TS_HOSTNAME=                           # Tailscale device hostname
VPN_IFACE=wg0                          # generic backend: interface to read the VPN IP from
VPN_IP=                                # generic backend: fixed VPN IP override

# ── Benchmark / CI knobs ────────────────────────────────────────────────────
BENCH_MIN_TPS=250                      # perf-regression gate floor (bench.js --min-tps)
