{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["darm-ann"],
  "title": "DARM-ANN Cluster",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Memory tier entries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "darm_tier_entries", "legendFormat": "{{instance}} {{tier}}" }
      ]
    },
    {
      "id": 2,
      "title": "LTM chain height (STM)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "darm_stm_chain_height", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 3,
      "title": "Chain validity (1=valid)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "darm_ltm_chain_valid", "legendFormat": "LTM {{instance}}" },
        { "expr": "darm_stm_chain_valid", "legendFormat": "STM {{instance}}" }
      ]
    },
    {
      "id": 4,
      "title": "RRC hit rate",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" } },
      "targets": [
        { "expr": "darm_rrc_hit_rate", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "title": "Active validators",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "darm_validators", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 6,
      "title": "Mempool size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "darm_mempool_size", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 7,
      "title": "Markov chain-graph (states / edges)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "darm_markov_states", "legendFormat": "{{instance}} states" },
        { "expr": "darm_markov_edges", "legendFormat": "{{instance}} edges" }
      ]
    },
    {
      "id": 8,
      "title": "Vocabulary size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "expr": "darm_vocab_size", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 9,
      "title": "Membership version",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "darm_membership_version", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
